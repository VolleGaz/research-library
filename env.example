# Each teammate must change these paths to match their own computer.
PAPERS_DIR="/absolute/path/to/ResearchLibrary/papers"
OUTPUT_DIR="/absolute/path/to/ResearchLibrary/output"
DB_PATH="/absolute/path/to/research-library/data/papers.db"

# Ollama's OpenAI-compatible endpoint (change if using LM Studio).
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama"
LLM_MODEL="llama3.2"

# Keep the actual webhook URL in .env only, not in Git.
DISCORD_WEBHOOK_URL=""
